# Server configuration
PORT=3000
APP_ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=recodations
DB_SSLMODE=disable

# Cache L2 (Redis)
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# Google Cloud Storage & floci-gcp emulator
GOOGLE_CLOUD_PROJECT=floci-local
STORAGE_EMULATOR_HOST=http://localhost:4588
GCS_BUCKET_NAME=photos

# Authentication & Security
JWT_SECRET=super-secret-jwt-token-key-32-bytes!

# Distributed ID Generator
SNOWFLAKE_NODE_ID=1
